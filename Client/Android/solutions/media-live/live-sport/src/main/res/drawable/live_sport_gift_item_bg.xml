<?xml version="1.0" encoding="utf-8"?>
<!--
  Selected-gift cell background: subtle translucent fill + accent border with
  rounded corners. Matches the dark side-panel visual language.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F4D8CFF" />
            <stroke
                android:width="1dp"
                android:color="#4D8CFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
