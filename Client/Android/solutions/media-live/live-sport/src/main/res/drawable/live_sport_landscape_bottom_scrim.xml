<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom scrim for the landscape overlay (mirrors the top scrim). Black
  gradient, darkest at the bottom easing to transparent at the top so the
  pause / input / multi-camera controls stay legible over the video.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"
    android:dither="true">
    <gradient
        android:angle="90"
        android:startColor="#99000000"
        android:endColor="#00000000"
        android:type="linear" />
</shape>
