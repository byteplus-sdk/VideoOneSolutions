<?xml version="1.0" encoding="utf-8"?>
<!--
  SwitchCompat track for the settings panel (Figma component 10732:106886
  Small 20). Same recipe as .localFiles/codes/tvupush_switch_track_custom.xml:
  only `size:height` + corner radius are set, the host view drives the width
  via `switchMinWidth`. Don't add a fixed width here — it makes SwitchCompat's
  internal layout clip the thumb.
   - Checked: success-green #1CB267
   - Unchecked: light grey #E5E6EB (Arco neutral fill 3)
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#1CB267" />
            <corners android:radius="20dp" />
            <size android:height="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E5E6EB" />
            <corners android:radius="20dp" />
            <size android:height="20dp" />
        </shape>
    </item>
</selector>
