<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-width landscape comment composer. Shown in its own focusable dialog
  window (adjustResize) so it rides directly above the soft keyboard while the
  host Activity keeps its adjustNothing softInputMode. The dialog is anchored to
  the bottom; the EditText fills the width with a trailing Send button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <EditText
        android:id="@+id/composer_input"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:background="@drawable/live_sport_landscape_input_bg"
        android:gravity="center_vertical"
        android:hint="@string/live_sport_watch_input_hint"
        android:imeOptions="actionSend"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0B0B0"
        android:textCursorDrawable="@null"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/composer_send"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/live_sport_landscape_composer_send_bg"
        android:gravity="center"
        android:minWidth="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/live_sport_watch_send"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
