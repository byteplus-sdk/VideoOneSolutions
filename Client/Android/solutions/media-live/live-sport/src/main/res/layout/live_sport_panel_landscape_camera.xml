<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape multi-camera side-panel (Figma node 10796:42031). Right-anchored,
  full-height, fixed width, dark-grey (#2C2C2C) card with left rounded corners.
  Left-aligned white title at the top (12sp); horizontal thumbnail+name rows
  below.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/live_sport_landscape_camera_panel_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/live_sport_watch_multi_camera_title"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/landscape_camera_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="11dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none" />
</LinearLayout>
