<?xml version="1.0" encoding="utf-8"?>
<!--
  One row inside the protocol picker. Layout owns the tap target; the host
  populates the label/sub-label and toggles enabled state for the unsupported
  RTM case. Selected state shows the primary-blue check on the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/live_sport_settings_picker_row_bg"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/protocol_item_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#020814"
            android:textSize="16sp" />

        <!-- Sub-label: only shown when an option is unselectable (e.g. RTM
             unsupported) so the user understands why it's greyed out. -->
        <TextView
            android:id="@+id/protocol_item_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#80838A"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/protocol_item_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/live_sport_ic_check"
        android:visibility="gone" />
</LinearLayout>
