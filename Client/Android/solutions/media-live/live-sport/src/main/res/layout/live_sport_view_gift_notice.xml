<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="172dp"
        android:layout_height="42dp"
        android:background="@drawable/live_sport_gift_notice_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="6dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/gift_notice_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/live_sport_anchor_avatar"
            app:shapeAppearanceOverlay="@style/LiveSportCircleAvatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/gift_notice_sender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                tools:text="Me" />

            <TextView
                android:id="@+id/gift_notice_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                tools:text="Sent Rose" />
        </LinearLayout>

        <ImageView
            android:id="@+id/gift_notice_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/live_sport_ic_gift_rose" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="x"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/gift_notice_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:fontFamily="sans-serif"
            android:minWidth="20dp"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold|italic"
            tools:text="1" />
    </LinearLayout>

</LinearLayout>
