<?xml version="1.0" encoding="utf-8"?>
<!--
  White card background for the LANDSCAPE settings side panel. Same white fill
  as the portrait BottomSheet card but with left-rounded corners (top-left +
  bottom-left) since the panel docks to the right edge and slides in from the
  right.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners
        android:topLeftRadius="20dp"
        android:bottomLeftRadius="20dp" />
</shape>
