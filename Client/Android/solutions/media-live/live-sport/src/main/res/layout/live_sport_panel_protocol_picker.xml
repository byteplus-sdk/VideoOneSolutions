<?xml version="1.0" encoding="utf-8"?>
<!--
  Protocol picker BottomSheet (child of the settings panel). Holds the title
  row plus a vertical container that the host fills with one
  live_sport_panel_protocol_item per option. Reuses the same panel background
  drawable for visual consistency.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/live_sport_settings_panel_bg"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/live_sport_watch_protocol_picker_title"
            android:textColor="#1D2129"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_protocol_picker_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/live_sport_settings_close_bg"
            android:contentDescription="@string/live_sport_watch_close"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/live_sport_ic_close_dark" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/protocol_picker_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp" />
</LinearLayout>
