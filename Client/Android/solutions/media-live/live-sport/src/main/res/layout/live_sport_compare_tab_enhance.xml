<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <!-- ===== Description card ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/live_sport_compare_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="@string/live_sport_compare_enhance_desc"
                android:textColor="#737A87"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_view_doc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/live_sport_compare_doc_pill_bg"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="@string/live_sport_compare_view_doc"
                android:textColor="#306FFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== Enhancement card: switches + two players ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/live_sport_compare_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Switch row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_sport_compare_enhance_sr"
                    android:textColor="#42464E"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_sr"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:checked="true"
                    app:showText="false"
                    app:switchMinWidth="36dp"
                    app:thumbTint="@color/live_sport_switch_thumb_color"
                    app:thumbTintMode="multiply"
                    app:track="@drawable/live_sport_switch_track_blue"
                    app:trackTint="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="@string/live_sport_compare_enhance_sharpen"
                    android:textColor="#42464E"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_sharpen"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:checked="true"
                    app:showText="false"
                    app:switchMinWidth="36dp"
                    app:thumbTint="@color/live_sport_switch_thumb_color"
                    app:thumbTintMode="multiply"
                    app:track="@drawable/live_sport_switch_track_blue"
                    app:trackTint="@null" />
            </LinearLayout>

            <!-- Processed player -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <FrameLayout
                    android:id="@+id/player_frame_processed"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/live_sport_compare_player_placeholder_bg"
                    app:layout_constraintDimensionRatio="H,16:9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextureView
                        android:id="@+id/player_texture_processed"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="8dp"
                        android:background="@drawable/live_sport_compare_overlay_pill_bg"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="@string/live_sport_compare_enhance_label_processed"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/btn_play_pause_processed"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/live_sport_compare_play_pause"
                        android:scaleType="centerInside"
                        android:src="@drawable/live_sport_ic_play_pause" />

                    <ImageView
                        android:id="@+id/btn_mute_processed"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/live_sport_compare_mute_toggle"
                        android:scaleType="centerInside"
                        android:src="@drawable/live_sport_compare_ic_mute_toggle" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Original player -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <FrameLayout
                    android:id="@+id/player_frame_origin"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/live_sport_compare_player_placeholder_bg"
                    app:layout_constraintDimensionRatio="H,16:9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextureView
                        android:id="@+id/player_texture_origin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="8dp"
                        android:background="@drawable/live_sport_compare_overlay_pill_bg"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="@string/live_sport_compare_enhance_label_origin"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/btn_play_pause_origin"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/live_sport_compare_play_pause"
                        android:scaleType="centerInside"
                        android:src="@drawable/live_sport_ic_play_pause" />

                    <ImageView
                        android:id="@+id/btn_mute_origin"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/live_sport_compare_mute_toggle"
                        android:scaleType="centerInside"
                        android:src="@drawable/live_sport_compare_ic_mute_toggle" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
