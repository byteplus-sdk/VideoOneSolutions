{
  "expo": {
    "name": "video-one-rn",
    "slug": "video-one-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "scheme": "videoonern",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.byteplus.videoone.rn",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "需要访问本地网络以发现投屏设备（Cast / AirPlay），并在开发模式下连接调试服务器。",
        "NSBonjourServices": [
          "_airplay._tcp",
          "_googlecast._tcp",
          "_CC1AD845._googlecast._tcp",
          "_expo._tcp"
        ]
      },
      "appleTeamId": "L5HCL383AF"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.byteplus.videoone.rn"
    },
    "update": {
      "assetPatternsToBeBundled": [
        "**/*"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://artifact.byteplus.com/repository/public/",
              "https://artifact.bytedance.com/repository/Volcengine/"
            ]
          }
        }
      ],
      "./plugins/withPodfileSources",
      "./plugins/withLicense",
      "./plugins/withGoogleCast"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
