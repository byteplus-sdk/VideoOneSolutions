{
  "name": "video-one-rn",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear --reset-cache",
    "prebuild": "npx expo prebuild --clean",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "bash scripts/setup-android-node.sh && cd android && ./gradlew --stop && cd .. && expo run:android",
    "android:release": "bash scripts/setup-android-node.sh && cd android && NODE_ENV=production ./gradlew :app:assembleRelease",
    "ios": "expo run:ios --device",
    "ios:release": "expo run:ios --device --configuration Release",
    "ios:archive": "NODE_ENV=production xcodebuild -workspace ios/videoonern.xcworkspace -scheme videoonern -configuration Release -sdk iphoneos -archivePath ios/build/videoonern.xcarchive archive",
    "lint": "expo lint"
  },
  "dependencies": {
    "@byteplus/react-native-vod-player": "1.10.0",
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.15",
    "@react-navigation/native": "^7.1.33",
    "expo": "~55.0.0",
    "expo-blur": "~55.0.14",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.32",
    "expo-font": "~55.0.7",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.10",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-screen-orientation": "~55.0.14",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.8",
    "expo-system-ui": "~55.0.17",
    "expo-web-browser": "~55.0.15",
    "lottie-react-native": "^7.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-google-cast": "^4.9.1",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "~4.3.0",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.2",
    "react-native-webview": "~13.16.1",
    "react-native-worklets": "~0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/config-plugins": "~55.0.8",
    "@types/react": "~19.2.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "react-native-svg-transformer": "1.5.3",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
